<view class="page"><view class="eyebrow">WORK ARCHIVE</view><view class="title">每一份付出，都有迹可循。</view><view class="subtitle">记录过程，整理经验，也看见自己的成长。</view><view wx:if="error" class="warning">{{error}}</view>
 <view class="tabs"><view class="tab {{tab==='incidents'?'selected':''}}" data-tab="incidents" bindtap="tab">突发事件</view><view class="tab {{tab==='meetings'?'selected':''}}" data-tab="meetings" bindtap="tab">班会档案</view><view class="tab {{tab==='summary'?'selected':''}}" data-tab="summary" bindtap="tab">工作总结</view></view>
 <block wx:if="tab!=='summary'"><view class="row"><input class="input min-width" placeholder="搜索档案内容" value="{{query}}" bindinput="search"/><button class="primary small nowrap" bindtap="add">＋ {{tab==='incidents'?'记事件':'记班会'}}</button></view></block>
 <block wx:if="tab==='incidents'"><view class="actions"><view class="folder {{folder==='all'?'selected':''}}" data-id="all" bindtap="folder">全部档案</view><view wx:for="{{folders}}" wx:key="id" class="folder {{folder===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="folder">{{item.name}}</view><view class="link" bindtap="newFolder">＋ 文件夹</view></view><view class="form-note">长按事件卡片可移动到文件夹。</view><view wx:for="{{incidents}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="editIncident" bindlongpress="move"><view class="row"><view class="task-name min-width">{{item.title}}</view><view class="badge {{item.status==='closed'?'':'high'}}">{{item.statusName}}</view></view><view class="meta">{{item.date}} {{item.time}} · {{item.folderName}}</view><view class="summary-copy">{{item.description}}</view><view class="result" wx:if="item.result" style="margin-top:18rpx">处理结果：{{item.result}}</view></view><view wx:if="!incidents.length" class="card empty">暂无事件档案。需要时可随手记下经过。</view></block>
 <block wx:if="tab==='meetings'"><view wx:for="{{meetings}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="editMeeting"><view class="row"><view class="task-name min-width">{{item.topic || '待记录主题'}}</view><view class="badge {{item.status==='held'?'':'high'}}">{{item.status==='held'?'已开展':'已安排'}}</view></view><view class="meta">{{item.date}} {{item.time}}</view><view class="summary-copy">{{item.content || '点此补充班会内容'}}</view><view wx:if="item.followUp" class="meta">后续安排：{{item.followUp}}</view></view><view wx:if="!meetings.length" class="card empty">还没有班会记录，先记下本周的主题。</view></block>
 <block wx:if="tab==='summary'"><view class="tabs"><view class="tab {{period==='week'?'selected':''}}" data-period="week" bindtap="period">每周</view><view class="tab {{period==='month'?'selected':''}}" data-period="month" bindtap="period">每月</view><view class="tab {{period==='year'?'selected':''}}" data-period="year" bindtap="period">每年</view><view class="tab {{period==='term'?'selected':''}}" data-period="term" bindtap="period">本学期</view></view><picker mode="date" value="{{day}}" bindchange="date"><view class="picker">选择总结所在日期：{{day}} ▾</view></picker><view class="meta">统计区间 {{start}} 至 {{end}}</view><view class="stat-grid" style="margin-top:24rpx"><view class="stat" data-kind="completed" bindtap="detail"><view class="stat-label">完成事项</view><view class="stat-number">{{stats.completed}}</view><view class="link">查看明细 →</view></view><view class="stat" data-kind="meetings" bindtap="detail"><view class="stat-label">已开展班会</view><view class="stat-number">{{stats.meetings}}</view><view class="link">查看明细 →</view></view><view class="stat" data-kind="incidents" bindtap="detail"><view class="stat-label">新增 / 办结事件</view><view class="stat-number">{{stats.incidentNew}} / {{stats.incidentClosed}}</view><view class="link">查看新增明细 →</view></view><view class="stat" data-kind="interviews" bindtap="detail"><view class="stat-label">学生访谈</view><view class="stat-number">{{stats.interviews}}</view><view class="link">查看明细 →</view></view></view><view wx:if="detailKind" class="card"><view class="section">统计明细</view><view wx:for="{{details}}" wx:key="key" class="task" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="editDetail"><view class="task-name">{{item.title}}</view><view class="meta">{{item.date}}</view></view><view wx:if="!details.length" class="empty">该区间暂无记录。</view></view><view class="card"><view class="section">工作总结</view><view class="summary-copy">{{summary}}</view><button class="primary" style="margin-top:26rpx" bindtap="exportSummary">导出总结文本</button></view></block>
 <view class="footer-note">记录按实际发生或完成时间统计 · 示例资料亦计入当前统计</view></view>
