<view class="page"><view class="eyebrow">WORK RECORD</view><view class="title">{{id?'编辑':'新建'}}{{pageTitle}}</view><view wx:if="error" class="warning">{{error}}</view><view class="card">
 <block wx:if="kind==='item'"><view class="field"><text class="field-label">事项名称 <text class="required">*</text></text><input class="input" value="{{form.title}}" data-field="title" bindinput="input" placeholder="例如：提交期中考试班级分析" maxlength="200"/></view><view class="field-row"><view class="field"><text class="field-label">工作分类</text><picker range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="category"><view class="picker">{{categories[categoryIndex].label}} ▾</view></picker></view><view class="field"><text class="field-label">轻重缓急</text><picker range="{{priorities}}" range-key="label" value="{{priorityIndex}}" bindchange="priority"><view class="picker">{{priorities[priorityIndex].label}} ▾</view></picker></view></view></block>
 <block wx:if="kind==='student'"><view class="field"><text class="field-label">学生代号 <text class="required">*</text></text><input class="input" value="{{form.code}}" data-field="code" bindinput="input" placeholder="使用代号，例如 S-012" maxlength="40"/></view><view class="field"><text class="field-label">学生情况</text><textarea class="input" auto-height value="{{form.situation}}" data-field="situation" bindinput="input" placeholder="记录已了解的情况和事实，避免标签化判断" maxlength="10000"/></view></block>
 <block wx:if="kind==='incident'"><view class="field"><text class="field-label">事件名称 <text class="required">*</text></text><input class="input" value="{{form.title}}" data-field="title" bindinput="input" placeholder="用一句话概括事件" maxlength="200"/></view></block>
 <block wx:if="kind==='meeting'"><view class="field"><text class="field-label">班会主题 <text class="required">*</text></text><input class="input" value="{{form.topic}}" data-field="topic" bindinput="input" placeholder="例如：学会表达，也学会倾听" maxlength="200"/></view></block>
 <block wx:if="kind!=='student'"><view class="field-row"><view class="field"><view class="row"><text class="field-label">{{kind==='interview'?'访谈日期':kind==='incident'?'发生日期':'日期'}} <text wx:if="kind!=='item'" class="required">*</text></text><view wx:if="kind==='item'" class="link" data-field="date" bindtap="clear">清空</view></view><picker mode="date" value="{{form.date}}" data-field="date" bindchange="input"><view class="picker">{{form.date || '待安排'}} ▾</view></picker></view><view class="field"><view class="row"><text class="field-label">时间</text><view wx:if="kind==='item'" class="link" data-field="time" bindtap="clear">清空</view></view><picker mode="time" value="{{form.time || '08:00'}}" data-field="time" bindchange="input"><view class="picker">{{form.time || '全天'}} ▾</view></picker></view></view></block>
 <block wx:if="kind==='item'"><view class="field"><view class="row"><text class="field-label">结束日期（跨天安排可填）</text><view class="link" data-field="endDate" bindtap="clear">清空</view></view><picker mode="date" value="{{form.endDate || form.date}}" data-field="endDate" bindchange="input"><view class="picker">{{form.endDate || '与开始日期相同'}} ▾</view></picker></view></block>
 <block wx:if="kind==='item' || kind==='incident' || kind==='meeting'"><view class="field"><text class="field-label">{{kind==='item'?'工作状态':kind==='incident'?'处理状态':'开展情况'}}</text><picker wx:if="kind==='item'" range="{{statuses}}" range-key="label" value="{{statusIndex}}" bindchange="status"><view class="picker">{{statuses[statusIndex].label}} ▾</view></picker><picker wx:if="kind==='incident'" range="{{incidentStatuses}}" range-key="label" value="{{statusIndex}}" bindchange="status"><view class="picker">{{incidentStatuses[statusIndex].label}} ▾</view></picker><picker wx:if="kind==='meeting'" range="{{meetingStatuses}}" range-key="label" value="{{statusIndex}}" bindchange="status"><view class="picker">{{meetingStatuses[statusIndex].label}} ▾</view></picker></view></block>
 <block wx:if="kind==='incident'"><view class="field"><text class="field-label">事件经过 <text class="required">*</text></text><textarea class="input" auto-height value="{{form.description}}" data-field="description" bindinput="input" placeholder="记录事件和了解到的事实" maxlength="15000"/></view><view class="field"><text class="field-label">处理方法</text><textarea class="input" auto-height value="{{form.method}}" data-field="method" bindinput="input" placeholder="采取了哪些处理措施" maxlength="15000"/></view><view class="field"><text class="field-label">处理结果</text><textarea class="input" auto-height value="{{form.result}}" data-field="result" bindinput="input" placeholder="进展、结果以及尚需处理的问题" maxlength="15000"/></view><view class="field"><text class="field-label">归档文件夹</text><picker range="{{folders}}" range-key="name" value="{{folderIndex}}" bindchange="folder"><view class="picker">{{folders[folderIndex].name || '未分类'}} ▾</view></picker></view></block>
 <block wx:if="kind==='incident' || kind==='item'"><view class="field"><text class="field-label">关联学生</text><picker range="{{students}}" range-key="code" value="{{studentIndex}}" bindchange="student"><view class="picker">{{students[studentIndex].code}} ▾</view></picker></view></block>
 <block wx:if="kind==='interview' || kind==='meeting'"><view class="field"><text class="field-label">{{kind==='interview'?'访谈内容':'班会主要内容'}} <text wx:if="kind==='interview'" class="required">*</text></text><textarea class="input" auto-height value="{{form.content}}" data-field="content" bindinput="input" placeholder="记录实际沟通、开展的内容" maxlength="15000"/></view><view class="field" wx:if="kind==='interview'"><text class="field-label">采取措施 / 后续支持</text><textarea class="input" auto-height value="{{form.action}}" data-field="action" bindinput="input" maxlength="10000" placeholder="记录后续可执行的支持措施"/></view><view class="field" wx:if="kind==='meeting'"><text class="field-label">后续跟进安排</text><textarea class="input" auto-height value="{{form.followUp}}" data-field="followUp" bindinput="input" maxlength="10000" placeholder="需要继续关注和开展的工作"/></view></block>
 <block wx:if="kind==='student' || kind==='interview' || kind==='incident'"><view class="field"><view class="row"><text class="field-label">下次跟进 / 复查日期</text><view class="link" data-field="followUpDate" bindtap="clear">清空</view></view><picker mode="date" value="{{form.followUpDate || form.date}}" data-field="followUpDate" bindchange="input"><view class="picker">{{form.followUpDate || '暂不设置'}} ▾</view></picker><view class="form-note">设置后同步生成待办；微信推送尚未连接。</view></view></block>
 <block wx:if="kind==='item'"><view class="field"><text class="field-label">备注 / 原始通知</text><textarea class="input" auto-height value="{{form.notes}}" data-field="notes" bindinput="input" placeholder="补充地点、要求和材料等" maxlength="20000"/></view><view class="switch-row"><view><view class="field-label">需要提醒</view><view class="form-note">此开关保存提醒偏好</view></view><switch checked="{{form.remind}}" color="#315b47" bindchange="remind"/></view><view wx:if="form.remind" class="field"><text class="field-label">提前提醒（分钟）</text><input class="input" type="number" value="{{form.remindBefore}}" data-field="remindBefore" bindinput="input"/><view class="form-note">0 为当天，1440 为提前一天；后台定时推送未接入。</view></view></block>
 </view>
 <block wx:if="kind==='student' &amp;&amp; id"><view class="row"><view class="section">访谈时间轴</view><button class="secondary small" bindtap="addInterview">＋ 记录访谈</button></view><view class="card"><view wx:for="{{interviews}}" wx:key="id" class="timeline-item" data-id="{{item.id}}" bindtap="editInterview"><view class="meta">{{item.date}} {{item.time}}</view><view class="summary-copy">{{item.content}}</view><view wx:if="item.action" class="result" style="margin-top:12rpx">后续措施：{{item.action}}</view><view class="link">编辑记录 →</view></view><view wx:if="!interviews.length" class="empty">还没有访谈记录，记下第一次关心。</view></view></block>
 <view wx:if="kind==='student' &amp;&amp; relatedIncidents.length" class="card"><view class="section">关联事件</view><view wx:for="{{relatedIncidents}}" wx:key="id" class="task" data-id="{{item.id}}" bindtap="relatedIncident"><view class="task-name">{{item.title}}</view><view class="meta">{{item.date}} · 点击查看事件档案</view></view></view><view class="actions"><button class="primary half" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存到本机</button><button wx:if="id &amp;&amp; (kind==='student' || kind==='incident' || kind==='meeting')" class="secondary half" bindtap="export">导出档案表</button></view><button wx:if="id" class="danger" style="margin-top:26rpx;width:100%" bindtap="remove">删除此记录</button><view class="footer-note">本机保存 · 请在“我的”定期导出完整备份</view></view>
