<view class="page"><view class="eyebrow">SCHEDULE</view><view class="title">把重要的日子，记清楚。</view><view class="subtitle">{{settings.termName}} · 第 {{termWeek}} 周</view><view wx:if="error" class="warning">{{error}}</view>
 <view class="row"><view class="tabs"><view class="tab {{mode==='week'?'selected':''}}" data-mode="week" bindtap="mode">本周周程</view><view class="tab {{mode==='month'?'selected':''}}" data-mode="month" bindtap="mode">学期月历</view></view><view class="link" bindtap="import">识别周程</view></view>
 <view class="card"><view class="row"><button class="secondary small" bindtap="prev">‹</button><picker mode="date" value="{{day}}" bindchange="pick"><view>{{monthLabel}} ▾</view></picker><button class="secondary small" bindtap="next">›</button><button class="secondary small" bindtap="today">今天</button></view><view class="calendar-grid"><view wx:for="{{weekdays}}" wx:key="*this" class="day-head">{{item}}</view><view wx:for="{{days}}" wx:key="date" class="day-cell {{item.today?'today':''}} {{item.selected?'selected':''}} {{item.dim?'dim':''}}" data-date="{{item.date}}" bindtap="select"><view>{{item.label}}</view><view wx:if="item.count" class="day-dot"></view><view wx:if="item.count" class="count">{{item.count}}项</view></view></view></view>
 <view class="row"><view class="section">{{day}} 的安排</view><button class="primary small" bindtap="add">＋ 新建</button></view><view class="tabs"><view class="tab {{category==='all'?'selected':''}}" data-category="all" bindtap="category">全部</view><view class="tab {{category==='exam'?'selected':''}}" data-category="exam" bindtap="category">考试</view><view class="tab {{category==='activity'?'selected':''}}" data-category="activity" bindtap="category">活动</view><view class="tab {{category==='meeting'?'selected':''}}" data-category="meeting" bindtap="category">班会</view><view class="tab {{category==='material'?'selected':''}}" data-category="material" bindtap="category">材料</view></view>
 <view class="card"><view wx:for="{{items}}" wx:key="id" class="task row"><view class="min-width" data-id="{{item.id}}" bindtap="edit"><view class="task-name"><text class="number">{{item.no}}.</text>{{item.title}}</view><view class="meta">{{item.time || '全天'}} · {{item.categoryName}} {{item.status==='done'?'· 已完成':''}}</view><view class="meta" wx:if="item.endDate">持续至 {{item.endDate}}</view><view wx:if="item.remind" class="small-text">提醒偏好已保存 · 微信未连接</view></view><view class="remind-circle" data-id="{{item.id}}" bindtap="remind"><view class="circle {{item.remind?'active':''}}">{{item.remind?'●':'○'}}</view><view class="remind-label">提醒</view></view></view><view wx:if="!items.length" class="empty">这一天没有安排，可以新增或识别周程。</view></view><view class="footer-note">日程与待办共用一份工作记录 · 修改后同步更新</view></view>
