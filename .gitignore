# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/sites-vite-plugin.LICENSE
!/build/sites-vite-plugin.ts
!/build/sites-worker.ts
!/build/local-ai-plugin.ts
!/build/teacher-ocr-plugin.ts
*.tsbuildinfo

/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

/dist-local/

# Deployment and account credentials live outside source.
/deploy/runtime/node_modules/
*.pem
*.key

# Local Python launcher bytecode.
__pycache__/
*.pyc

# Generated WeChat project and machine-specific public configuration
/miniprogram/
/mini.config.local.json
/mini-typecheck.json

/teacher-miniprogram/

/teacher-mini.config.local.json

# Local deployment destinations and private synchronization backups.
/cloud-tunnel.config.local.json
/credentials.local.*
/.openai/hosting.json
# The OCR development plugin is source, not generated build output.
!/build/teacher-ocr-plugin.ts
