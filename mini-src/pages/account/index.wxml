<view class="page"><view class="brand">YOUR SPACE.</view><view class="title">我的时序。</view><button wx:if="!signedIn" class="primary" bindtap="login">微信登录 / 加入内测</button><block wx:else><view class="card"><view class="name">{{user.displayName}}</view><view class="badge">{{accessLabel}}</view><view class="meta">资格期限：{{endsLabel}}</view><view class="meta">今日 AI 请求：{{access.dailyUsed}} / {{access.dailyLimit}}</view><view class="muted">{{access.quotaPolicy}}</view><view class="muted">当前为邀请内测，暂不收费。</view><view class="field"><input value="{{inviteCode}}" bindinput="input" maxlength="35" placeholder="新的邀请码（可选）"/></view><button class="secondary" bindtap="redeem">兑换内测权益</button></view><view class="card"><view class="section">AI 用量</view><view wx:if="usage"><view class="name">本月 {{usage.month.requests}} 次请求</view><view class="meta">成功 {{usage.month.succeeded}} · 失败 {{usage.month.failed}} · 拒绝 {{usage.month.rejected}}</view><view class="meta">{{usage.month.total_tokens}} 个已知 Token · {{usage.month.metered_calls}} 次返回用量</view><view class="muted">缺失的 Token 为未知。未配置服务商单价，不推测费用。</view></view><view class="error">{{usageError}}</view><button class="secondary" bindtap="refresh">刷新状态与用量</button></view><button class="secondary" disabled="{{!access.canUse}}" bindtap="settings">工作时间与偏好</button><button class="secondary" bindtap="export">导出任务备份</button><button class="secondary" bindtap="privacy">内测隐私说明</button><button class="secondary" bindtap="logout">退出账号</button><view class="sync">内测版 {{version}} · {{status}}</view><view class="error">{{error}}</view></block></view>
