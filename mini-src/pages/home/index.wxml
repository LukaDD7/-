<view class="page"><view class="brand">时序 · SHIXU</view><view class="title">把今天，安排得刚刚好。</view><view class="subtitle">少一点反复规划，多一点专注行动。</view>
<view wx:if="!signedIn" class="card"><view class="section">你的计划，在微信里继续。</view><view class="muted">当前为邀请内测。使用邀请码加入，或绑定已有网页账号。</view><button class="primary" bindtap="login">微信登录 / 加入内测</button></view>
<block wx:else><view wx:if="!access.canUse" class="warning">当前权益不可用。可以查看并导出已有计划，请联系管理员续期。</view><view wx:if="error || cacheError" class="warning">{{error || '本机缓存空间不足，请及时导出备份。'}}</view>
<view class="card green"><view class="muted">让重要的事有位置</view><view class="row"><view class="section">{{tasks.length}} 项{{showCompleted?'已完成':'待完成'}}</view><button class="secondary small" disabled="{{!access.canUse}}" bindtap="add">＋ 添加任务</button></view><view class="muted" bindtap="review">{{warningCount?warningCount+' 项任务需要调整，查看每日复查':'打开每日复查，接住没做完的事'}} →</view></view>
<view class="card"><view class="row"><button class="secondary small" bindtap="prev">‹</button><picker mode="date" value="{{day}}" bindchange="date"><view>{{dateLabel}} ▾</view></picker><button class="secondary small" bindtap="next">›</button><button class="secondary small" bindtap="today">今天</button></view><view class="section">日程安排</view><view wx:for="{{events}}" wx:key="id" class="task" data-id="{{item.id}}" bindtap="editEvent"><view class="badge">固定日程</view><view class="name">{{item.title}}</view><view class="time">{{item.time}}</view></view><view wx:for="{{blocks}}" wx:key="id" class="task" data-id="{{item.taskId}}" bindtap="edit"><view class="time">{{item.time}}</view><view class="name">{{item.title}}</view></view><view wx:if="!blocks.length && !events.length" class="empty">给今天留一点从容。</view><view class="actions"><button class="secondary small" disabled="{{!access.canUse}}" bindtap="replan">重新安排</button><button class="secondary small" disabled="{{!access.canUse}}" bindtap="fixed">＋ 固定日程</button></view></view>
<view class="row"><view class="section">{{showCompleted?'已完成':'任务清单'}}</view><view class="link" bindtap="completed">{{showCompleted?'查看待完成':'查看已完成'}}</view></view><view class="card"><view class="task" wx:for="{{tasks}}" wx:key="id"><view class="row"><view data-id="{{item.id}}" bindtap="edit"><view class="name">{{item.title}}</view><view class="meta">剩余 {{item.remaining}} · 已投入 {{item.worked}}</view><view class="meta">{{item.deadline || '无截止日期'}} {{item.deadlineTime}} {{item.locked?'· 已锁定':''}}</view></view><button class="secondary small" disabled="{{!access.canUse}}" data-id="{{item.id}}" bindtap="toggle">{{item.completed?'恢复':'完成'}}</button></view></view><view class="empty" wx:if="!tasks.length">暂时没有任务</view></view>
<view class="warning" wx:if="status==='conflict'">其他设备更新了计划，本机修改仍保留。<view class="actions"><button class="secondary small" bindtap="cloud">使用云端</button><button class="danger small" bindtap="local">保留本机并覆盖</button></view></view><view class="row"><view class="sync">{{statusText}} · 内测版 0.5</view><button wx:if="canUndo" class="secondary small" bindtap="undo">撤销</button><button wx:if="status==='offline'" class="secondary small" bindtap="retry">重试连接</button></view></block></view>
