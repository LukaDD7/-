<view class="page"><view class="brand">KEEP YOUR COMMITMENTS.</view><view class="title">{{id?'固定日程':'添加固定日程'}}</view><view class="subtitle">固定日程不会被自动移动，任务会绕开这些时间。</view><view class="card"><view class="field"><view class="label">日程名称</view><input value="{{title}}" data-field="title" bindinput="input" maxlength="200"/></view><view class="field"><view class="label">日期</view><picker mode="date" value="{{day}}" data-field="day" bindchange="input"><view class="picker">{{day}}</view></picker></view><view class="grid"><view class="field"><view class="label">开始时间</view><picker mode="time" value="{{start}}" data-field="start" bindchange="input"><view class="picker">{{start}}</view></picker></view><view class="field"><view class="label">结束时间</view><picker mode="time" value="{{end}}" data-field="end" bindchange="input"><view class="picker">{{end}}</view></picker></view></view><view class="error">{{error}}</view><button class="primary" disabled="{{!canUse || missing}}" bindtap="save">保存并重新安排</button><button wx:if="id" class="danger" disabled="{{!canUse}}" bindtap="remove">删除固定日程</button></view></view>
