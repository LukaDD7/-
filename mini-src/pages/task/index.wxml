<view class="page"><view class="brand">MAKE ROOM FOR WHAT MATTERS.</view><view class="title">{{id?'任务详情':'添加一件重要的事'}}</view><view class="warning" wx:if="warning">{{warning}}</view><view class="card"><view class="field"><view class="label">任务名称</view><input value="{{title}}" data-field="title" bindinput="input" maxlength="200"/></view><view class="grid"><view class="field"><view class="label">预计总耗时（分钟）</view><input type="number" value="{{minutes}}" data-field="minutes" bindinput="input"/></view><view class="field"><view class="label">已投入（分钟）</view><input type="number" value="{{worked}}" data-field="worked" bindinput="input"/></view><view class="field"><view class="label">剩余预计耗时（分钟）</view><input type="number" value="{{remaining}}" data-field="remaining" bindinput="input"/></view><view class="field"><view class="label">优先级</view><picker range="{{priorityLabels}}" value="{{priorityIndex}}" data-field="priorityIndex" bindchange="pick"><view class="picker">{{priorityLabels[priorityIndex]}}</view></picker></view></view><view class="muted">只安排剩余耗时。保存修改会解锁并重新安排。</view>
<view class="grid"><view class="field"><view class="label">截止日期</view><picker mode="date" value="{{deadline}}" data-field="deadline" bindchange="date"><view class="picker">{{deadline || '不设置'}}</view></picker><view class="link" data-field="deadline" bindtap="clear">清除日期</view></view><view class="field"><view class="label">截止时间（可选）</view><picker mode="time" value="{{deadlineTime}}" disabled="{{!deadline}}" data-field="deadlineTime" bindchange="date"><view class="picker">{{deadlineTime || '不设置'}}</view></picker><view class="link" data-field="deadlineTime" bindtap="clear">清除时间</view></view><view class="field"><view class="label">最早开始日期</view><picker mode="date" value="{{notBefore}}" data-field="notBefore" bindchange="date"><view class="picker">{{notBefore || '不设置'}}</view></picker><view class="link" data-field="notBefore" bindtap="clear">清除日期</view></view><view class="field"><view class="label">最早开始时间</view><picker mode="time" value="{{notBeforeTime}}" disabled="{{!notBefore}}" data-field="notBeforeTime" bindchange="date"><view class="picker">{{notBeforeTime || '不设置'}}</view></picker><view class="link" data-field="notBeforeTime" bindtap="clear">清除时间</view></view><view class="field"><view class="label">分类</view><picker range="{{categoryLabels}}" value="{{categoryIndex}}" data-field="categoryIndex" bindchange="pick"><view class="picker">{{categoryLabels[categoryIndex]}}</view></picker></view><view class="field"><view class="label">重复</view><picker range="{{repeatLabels}}" value="{{repeatIndex}}" data-field="repeatIndex" bindchange="pick"><view class="picker">{{repeatLabels[repeatIndex]}}</view></picker></view></view>
<view class="row field"><view>允许拆成多个专注时段</view><switch checked="{{splittable}}" bindchange="split" color="#486449"/></view><view class="field" wx:if="dependencies.length"><view class="label">前置任务</view><checkbox-group bindchange="deps"><label class="check" wx:for="{{dependencies}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}"/>{{item.title}}</label></checkbox-group></view><view class="field"><view class="label">备注</view><textarea value="{{notes}}" data-field="notes" bindinput="input" maxlength="5000"/></view><view class="error" wx:if="error">{{error}}</view><button class="primary" disabled="{{!canUse || missing}}" bindtap="save">保存并安排</button></view>
<view class="card" wx:if="id"><view class="actions"><button class="secondary" disabled="{{!canUse}}" bindtap="complete">{{completed?'恢复任务':'标为完成'}}</button><button wx:if="!completed" class="secondary" disabled="{{!canUse}}" bindtap="lock">{{locked?'解锁时间':'锁定时间'}}</button></view><button wx:if="!completed" class="secondary" disabled="{{!canUse}}" bindtap="postpone">将截止日期延后一天</button><view wx:for="{{blocks}}" wx:key="id" class="task"><view class="meta">{{item.time}}</view><view class="link" wx:if="!completed && canUse" data-id="{{item.id}}" bindtap="openMove">移动这个时段 →</view></view><view wx:if="moveId"><view class="section">移动并锁定</view><view class="grid"><picker mode="date" value="{{moveDay}}" data-field="moveDay" bindchange="date"><view class="picker">{{moveDay}}</view></picker><picker mode="time" value="{{moveTime}}" data-field="moveTime" bindchange="date"><view class="picker">{{moveTime}}</view></picker></view><button class="primary" bindtap="move">确认移动</button></view><button class="danger" disabled="{{!canUse}}" bindtap="remove">删除任务</button></view></view>
