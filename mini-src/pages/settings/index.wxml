<view class="page"><view class="brand">AT YOUR OWN PACE.</view><view class="title">按你的节奏安排。</view><view class="subtitle">固定时区：北京时间 UTC+8</view><view class="card"><view class="grid"><view class="field"><view class="label">开始工作</view><picker mode="time" value="{{workStart}}" data-field="workStart" bindchange="field"><view class="picker">{{workStart}}</view></picker></view><view class="field"><view class="label">结束工作</view><picker mode="time" value="{{workEnd}}" data-field="workEnd" bindchange="field"><view class="picker">{{workEnd}}</view></picker></view><view class="field"><view class="label">午休开始</view><picker mode="time" value="{{lunchStart}}" data-field="lunchStart" bindchange="field"><view class="picker">{{lunchStart}}</view></picker></view><view class="field"><view class="label">午休结束</view><picker mode="time" value="{{lunchEnd}}" data-field="lunchEnd" bindchange="field"><view class="picker">{{lunchEnd}}</view></picker></view></view><view class="field"><view class="label">任务间休息</view><picker range="{{breakLabels}}" value="{{breakIndex}}" bindchange="breaks"><view class="picker">{{breakMinutes}} 分钟</view></picker></view><view class="row field"><view>允许在周末安排任务</view><switch checked="{{weekends}}" bindchange="weekends" color="#486449"/></view><button class="primary" disabled="{{!canUse}}" bindtap="save">保存并重新安排</button></view></view>
