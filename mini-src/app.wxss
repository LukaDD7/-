page{background:#f5f6f0;color:#344c3e;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.page{padding:32rpx 28rpx 64rpx}.brand{font-size:28rpx;letter-spacing:4rpx;color:#839078}.title{font-size:46rpx;font-weight:600;margin:22rpx 0 12rpx}.subtitle,.muted{color:#87927e;font-size:24rpx;line-height:1.7}.card{background:#fff;border:1rpx solid #e3e8de;border-radius:26rpx;padding:28rpx;margin:24rpx 0}.green{background:#3e5b4a;color:#fff}.green .muted{color:#dce6d3}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.wrap{flex-wrap:wrap}.name{font-size:30rpx;font-weight:500;line-height:1.6}.meta{font-size:23rpx;color:#85907b;line-height:1.9}.task{padding:24rpx 0;border-bottom:1rpx solid #edf0e7}.task:last-child{border-bottom:0}.badge{display:inline-block;background:#edf1e6;color:#687c56;font-size:22rpx;padding:7rpx 14rpx;border-radius:10rpx;margin:6rpx 8rpx 6rpx 0}.warning{color:#a17345;background:#fff4e7;padding:20rpx;border-radius:14rpx;font-size:24rpx;line-height:1.7;margin:18rpx 0}.primary,.secondary,.danger{font-size:27rpx;border-radius:16rpx;margin:18rpx 0;padding:5rpx 22rpx;line-height:2.3}.primary{background:#3f5b49;color:#fff}.secondary{background:#edf1e7;color:#48633f}.danger{background:#fff1e9;color:#a06942}.small{font-size:23rpx;line-height:2;padding:3rpx 18rpx;margin:0}.actions{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:20rpx}.actions button{flex:1;min-width:180rpx}.field{margin:26rpx 0}.label{font-size:25rpx;color:#718466;margin-bottom:12rpx;display:block}input,textarea,.picker{box-sizing:border-box;width:100%;background:#fff;border:1rpx solid #dce3d4;border-radius:14rpx;padding:20rpx;min-height:78rpx;color:#354d3e;font-size:28rpx}textarea{min-height:220rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.grid .field{margin:14rpx 0}.check{display:flex;gap:14rpx;align-items:center;font-size:25rpx;padding:14rpx 0}.divider{height:1rpx;background:#e6ebdf;margin:28rpx 0}.empty{text-align:center;padding:55rpx 20rpx;color:#89957e}.section{font-size:31rpx;font-weight:600;margin:30rpx 0 12rpx}.sync{font-size:22rpx;color:#89937e;margin-top:26rpx}.ticket{word-break:break-all;user-select:text;background:#f3f5ef;padding:24rpx;line-height:1.8;font-size:25rpx}.error{color:#a05a3e;line-height:1.7;padding:18rpx 0}.choice{padding:12rpx 0}.time{font-size:25rpx;color:#6d8260;font-variant-numeric:tabular-nums}.checkbox{transform:scale(.85)}button::after{border:0}.link{color:#526f40;padding:20rpx 0;font-size:25rpx}
